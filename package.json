{
  "name": "navidrome-artists",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "oxfmt .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "js-md5": "0.9.2",
    "svelte": "5.57.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "nano-staged": "1.0.2",
    "oxfmt": "0.66.0",
    "simple-git-hooks": "2.14.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  },
  "nano-staged": {
    "*.{html,css,svelte,ts}": "oxfmt --no-error-on-unmatched-pattern --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  }
}
