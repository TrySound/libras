{
  "name": "libras",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "stress-build": "VITE_STRESS_ARTISTS=1 vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && pnpm --filter @libras/website check",
    "test": "vitest run",
    "format": "oxfmt .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@virtualstate/navigation": "1.0.1-alpha.212",
    "dialog-closedby-polyfill": "^1.3.0",
    "fuzzysort": "4.0.2",
    "invokers-polyfill": "^1.0.4",
    "js-md5": "0.9.2",
    "svelte": "5.57.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@unplugin-pwa/vite": "0.0.4",
    "@vite-pwa/workbox-swkit": "8.0.14",
    "happy-dom": "20.14.0",
    "magicast": "^0.5.0",
    "nano-staged": "1.0.2",
    "oxfmt": "0.66.0",
    "simple-git-hooks": "2.14.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "nano-staged": {
    "*.{html,css,svelte,ts}": "oxfmt --no-error-on-unmatched-pattern --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  }
}
